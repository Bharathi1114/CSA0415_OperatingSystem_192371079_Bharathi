#include <stdio.h>

int main(void) {
    int n, f, pages[50], frame[10], faults = 0;

    printf("Number of pages and frames: ");
    scanf("%d%d", &n, &f);
    printf("Enter page reference string: ");
    for (int i = 0; i < n; i++) scanf("%d", &pages[i]);
    for (int j = 0; j < f; j++) frame[j] = -1;

    for (int i = 0; i < n; i++) {
        int hit = 0;
        for (int j = 0; j < f; j++)
            if (frame[j] == pages[i]) hit = 1;

        if (!hit) {
            int replace = -1, farthest = -1;
            for (int j = 0; j < f; j++) {
                int k;
                for (k = i + 1; k < n && pages[k] != frame[j]; k++);
                if (k > farthest) { farthest = k; replace = j; }
            }
            frame[replace] = pages[i];
            faults++;
        }
    }

    printf("Page faults: %d\n", faults);
    return 0;
}#include <stdio.h>

