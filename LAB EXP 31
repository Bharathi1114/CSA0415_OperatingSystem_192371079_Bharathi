#include <stdio.h>

int main(void) {
    int n, f, pages[50], frame[10], next = 0, faults = 0;

    printf("Number of pages and frames: ");
    scanf("%d%d", &n, &f);
    printf("Enter page reference string: ");
    for (int i = 0; i < n; i++) scanf("%d", &pages[i]);
    for (int i = 0; i < f; i++) frame[i] = -1;

    for (int i = 0; i < n; i++) {
        int found = 0;
        for (int j = 0; j < f; j++)
            if (frame[j] == pages[i]) found = 1;

        if (!found) {
            frame[next] = pages[i];
            next = (next + 1) % f;
            faults++;
        }
        printf("%d: ", pages[i]);
        for (int j = 0; j < f; j++)
            if (frame[j] == -1) printf("- ");
            else printf("%d ", frame[j]);
        puts("");
    }
    printf("Page faults: %d\n", faults);
    return 0;
}#include <stdio.h>

