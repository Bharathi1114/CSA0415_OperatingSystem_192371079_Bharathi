#include <fcntl.h>
#include <unistd.h>
#include <stdio.h>

int main(void) {
    char text[] = "Hello from UNIX system calls\n";
    char buffer[100];
    int fd = open("sample.txt", O_CREAT | O_RDWR | O_TRUNC, 0644);

    if (fd < 0) { perror("open"); return 1; }
    write(fd, text, sizeof(text) - 1);
    lseek(fd, 0, SEEK_SET);
    int n = read(fd, buffer, sizeof(buffer) - 1);
    buffer[n] = '\0';
    printf("%s", buffer);
    close(fd);
    return 0;
