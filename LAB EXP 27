#include <dirent.h>
#include <stdio.h>

int main(void) {
    DIR *dir = opendir(".");
    struct dirent *entry;
    if (!dir) { perror("opendir"); return 1; }

    while ((entry = readdir(dir)) != NULL)
        puts(entry->d_name);

    closedir(dir);
    return 0;
