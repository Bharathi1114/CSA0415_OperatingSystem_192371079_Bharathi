#include <stdio.h>

int main(void) {
    int n, f, pages[50], frame[10], last[10], faults = 0;

    printf("Number of pages and frames: ");
    scanf("%d%d", &n, &f);
    printf("Enter page reference string: ");
    for (int i = 0; i < n; i++) scanf("%d", &pages[i]);
    for (int j = 0; j < f; j++) frame[j] = -1, last[j] = -1;

    for (int i = 0; i < n; i++) {
        int slot = -1;
        for (int j = 0; j < f; j++)
            if (frame[j] == pages[i]) slot = j;

        if (slot == -1) {
            slot = 0;
            for (int j = 0; j < f; j++)
                if (frame[j] == -1 || last[j] < last[slot]) slot = j;
            frame[slot] = pages[i];
            faults++;
        }
        last[slot] = i;
    }

    printf("Page faults: %d\n", faults);
    return 0;
}#include <stdio.h>

