#include <stdio.h>
#include <string.h>

#define MAX_FILES 100
#define NAME_LEN 64

int main(void) {
    char files[MAX_FILES][NAME_LEN];
    char name[NAME_LEN];
    int count = 0, choice;

    for (;;) {
        printf("\n1 Create  2 List  3 Search  4 Delete  0 Exit\nChoice: ");
        if (scanf("%d", &choice) != 1) return 1;
        if (choice == 0) break;

        if (choice == 2) {
            if (count == 0) puts("Directory is empty.");
            for (int i = 0; i < count; i++) puts(files[i]);
            continue;
        }

        if (choice < 1 || choice > 4) {
            puts("Invalid choice.");
            continue;
        }

        printf("File name (no spaces): ");
        if (scanf("%63s", name) != 1) return 1;

        int found = -1;
        for (int i = 0; i < count; i++) {
            if (strcmp(files[i], name) == 0) {
                found = i;
                break;
            }
        }

        if (choice == 1) {
            if (found != -1) puts("File already exists.");
            else if (count == MAX_FILES) puts("Directory is full.");
            else {
                strcpy(files[count++], name);
                puts("File created.");
            }
        } else if (choice == 3) {
            puts(found != -1 ? "File found." : "File not found.");
        } else if (found == -1) {
            puts("File not found.");
        } else {
            for (int i = found; i < count - 1; i++)
                strcpy(files[i], files[i + 1]);
            count--;
            puts("File deleted.");
        }
    }

    return 0;
}
