#include <stdio.h>

int main(void) {
    int blocks[10], processes[10], allocation[10];
    int nb, np;

    printf("Number of blocks: ");
    scanf("%d", &nb);
    printf("Enter block sizes: ");
    for (int i = 0; i < nb; i++) scanf("%d", &blocks[i]);

    printf("Number of processes: ");
    scanf("%d", &np);
    printf("Enter process sizes: ");
    for (int i = 0; i < np; i++) scanf("%d", &processes[i]);

    for (int i = 0; i < np; i++) {
        allocation[i] = -1;
        for (int j = 0; j < nb; j++) {
            if (blocks[j] >= processes[i]) {
                allocation[i] = j;
                blocks[j] -= processes[i];
                break;
            }
        }
    }

    for (int i = 0; i < np; i++)
        printf("Process %d -> Block %d\n", i + 1,
               allocation[i] == -1 ? 0 : allocation[i] + 1);
    return 0;
}#include <stdio.h>

