#include <stdio.h>
#include <unistd.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/wait.h>

int main()
{
    int id;
    int *ptr;
    pid_t pid;

    id = shmget(IPC_PRIVATE, sizeof(int), IPC_CREAT | 0666);

    if (id < 0)
    {
        printf("Shared memory creation failed\n");
        return 1;
    }

    ptr = (int *)shmat(id, NULL, 0);

    if (ptr == (void *)-1)
    {
        printf("Shared memory attachment failed\n");
        shmctl(id, IPC_RMID, NULL);
        return 1;
    }

    pid = fork();

    if (pid == 0)
    {
        *ptr = 100;
        printf("Child wrote: %d\n", *ptr);
    }
    else if (pid > 0)
    {
        wait(NULL);
        printf("Parent read: %d\n", *ptr);
    }
    else
    {
        printf("Process creation failed\n");
    }

    shmdt(ptr);
    shmctl(id, IPC_RMID, NULL);

    return 0;
}
