#include <stdio.h>
#include <unistd.h>

int main(void) {
    FILE *fp = fopen("data.txt", "w");
    if (!fp) return 1;
    fprintf(fp, "First line\n");
    fclose(fp);

    fp = fopen("data.txt", "a");
    fprintf(fp, "Appended line\n");
    fclose(fp);

    fp = fopen("data.txt", "r");
    char line[100];
    while (fgets(line, sizeof(line), fp)) printf("%s", line);
    fclose(fp);

    rename("data.txt", "newdata.txt");
    /* Uncomment to delete the file: remove("newdata.txt"); */
    return 0;
