#include <stdio.h>

int main(void) {
    int start, length;
    printf("Starting block and file length: ");
    scanf("%d%d", &start, &length);

    printf("Allocated blocks: ");
    for (int i = 0; i < length; i++) printf("%d ", start + i);
    puts("");
    return 0;
