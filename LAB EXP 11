#include <pthread.h>
#include <stdio.h>

#define INCREMENTS 1000000

static long counter = 0;
static pthread_mutex_t counter_mutex = PTHREAD_MUTEX_INITIALIZER;

typedef struct {
    const char *name;
} WorkerArgs;

void *count_up(void *argument) {
    const WorkerArgs *args = (const WorkerArgs *)argument;

    for (int i = 0; i < INCREMENTS; ++i) {
        /* The mutex ensures only one thread changes counter at a time. */
        pthread_mutex_lock(&counter_mutex);
        ++counter;
        pthread_mutex_unlock(&counter_mutex);
    }

    printf("%s finished its work.\n", args->name);
    return NULL;
}

int main(void) {
    pthread_t thread_a;
    pthread_t thread_b;
    WorkerArgs args_a = {"Thread A"};
    WorkerArgs args_b = {"Thread B"};

    /* Start two independent flows of execution. */
    if (pthread_create(&thread_a, NULL, count_up, &args_a) != 0 ||
        pthread_create(&thread_b, NULL, count_up, &args_b) != 0) {
        fprintf(stderr, "Could not create threads.\n");
        return 1;
    }

    /* Wait until both workers are done before reading the result. */
    pthread_join(thread_a, NULL);
    pthread_join(thread_b, NULL);

    printf("Final counter: %ld (expected %d)\n",
           counter, 2 * INCREMENTS);

    pthread_mutex_destroy(&counter_mutex);
    return 0;
}
