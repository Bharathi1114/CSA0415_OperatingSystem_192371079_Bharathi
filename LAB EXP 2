#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int f1, f2, n;
    char buffer[100];

    f1 = open("input.txt", O_RDONLY);
    f2 = open("output.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (f1 < 0 || f2 < 0)
    {
        printf("File opening failed");
        return 1;
    }

    while ((n = read(f1, buffer, sizeof(buffer))) > 0)
    {
        write(f2, buffer, n);
    }

    close(f1);
    close(f2);

    printf("File copied successfully");

    return 0;
}
